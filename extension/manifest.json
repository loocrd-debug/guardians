{
  "manifest_version": 3,
  "name": "가디언즈 빠른 품질 검사",
  "short_name": "가디언즈",
  "version": "6.23.0",
  "description": "보고 있는 페이지의 접근성(KWCAG 2.2)·KRDS(구조·디자인 토큰)·웹표준을 사이드 패널에서 즉시 검사합니다. 정밀 검사·결과서는 가디언즈 웹으로 이어집니다.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "가디언즈 — 이 페이지 품질 검사 (사이드 패널 열기)"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "devtools_page": "devtools.html",
  "web_accessible_resources": [
    {
      "resources": [
        "axe.min.js",
        "krds_ext.js",
        "runner.js",
        "std_ext.js",
        "suggest.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}